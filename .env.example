# Copy this file to ".env" (git-ignored) and adjust the path.
# This file contains NO secrets. It only tells Docker Compose where the secrets
# folder is. That folder must be OUTSIDE the project (docs/03 §5.5.1) and holds:
#   hms-app.env      HMS_APP_PASSWORD, HMS_WORKER_PASSWORD, HMS_PLATFORM_PASSWORD,
#                    HMS_JWT_ORG_KEYS, HMS_JWT_PLATFORM_KEYS (README step 1)
#   hms-admin.env    POSTGRES_PASSWORD, HMS_OWNER_PASSWORD, HMS_BACKUP_PASSWORD
#   data-keys.json   {"active": "<key id>", "keys": {"<key id>": "<base64 of 32 random bytes>"}}
#   pgbackrest.env   PGBACKREST_REPO1_CIPHER_PASS (encrypts the backups; README step 1)
HMS_SECRETS_DIR=C:/Users/<you>/hms-secrets

# Host port for the database container (default 5433; 5432 is often used by a native PostgreSQL).
# HMS_DB_HOST_PORT=5433

# Where backups go (Q5). Leave empty and they go to a Docker volume on the SAME disk as the
# database: fine for mistakes, useless if the disk dies. Point it at a second drive or an
# external disk, e.g. HMS_BACKUP_DIR=E:/hms-backups (docs/runbooks/restore.md).
HMS_BACKUP_DIR=
